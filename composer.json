{
    "name": "hesamrad/laravel-flashlight",
    "description": "A Laravel Package to Log Requests",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/hesamzakerirad/laravel-flashlight",
    "keywords": [
        "laravel",
        "php",
        "log",
        "http"
    ],
    "authors": [
        {
            "name": "Hesam Rad",
            "email": "hesamzakerirad@gmail.com",
            "homepage": "https://hesamrad.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/config": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "HesamRad\\Flashlight\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HesamRad\\Flashlight\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HesamRad\\Flashlight\\FlashlightServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
